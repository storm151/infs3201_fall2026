<h1>Find Customer</h1>

{{!-- Display Search Form --}}
<form action="/find-results" method="GET">
    <label for="phone">Phone Number </label>
    <input type="text" id="phone" name="phone" required>
    <button type="submit">Find</button>
</form>

{{!-- Display Error Message if customer is not found --}}
{{#if error}}
<p class="error-message">{{error}}</p>
{{/if}}

{{!-- Display Customer Information & Orders if customer is found --}}
{{#if customer}}
<div class="search-results">
    <h2>Search results</h2>
    <p><strong>Name: {{customer.name}}</strong> Orders:</p>

    <ul>
        {{#each customer.orders}}
        <li>{{this._id}}, {{this.orderDate}}, {{this.status}}, total: {{this.total}}</li>
        {{/each}}
    </ul>
</div>
{{/if}}