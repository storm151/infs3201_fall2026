<h1>Orders</h1>

<table>
    <thead>
        <tr>
            <th>Order ID</th>
            <th>Customer Name</th>
            <th>Date</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        {{#each orders}}
        <tr>
            <td>{{this._id}}</td>
            <td>{{this.customerName}}</td>
            <td>{{#if this.date}}{{this.date}}{{else}}{{this.orderDate}}{{/if}}</td>
            <td class="status-{{this.status}}">{{this.status}}</td>
            <td><a href="/update-status?order={{this._id}}">Update Status</a></td>
        </tr>
        {{/each}}
    </tbody>
</table>