<h1>Order ID: {{_id}}</h1>

{{#if customer}}
<p><strong>Customer:</strong> {{customer.name}} ({{customer.phone}})</p>
{{#if customer.pickupImage}}
<div class="pickup-image-container">
    <p><strong>Customer Pickup Location Image:</strong></p>
    <img src="{{customer.pickupImage}}" alt="Customer Pickup Location" class="pickup-image">
</div>
{{/if}}
{{/if}}

<form action="/update-status" method="POST">
    <input type="hidden" name="_id" value="{{_id}}">

    <label for="newStatus">New Status:</label>
    <select name="newStatus" id="newStatus" required>
        {{#if states}}
        {{#each states}}
        <option value="{{this}}">{{this}}</option>
        {{/each}}
        {{else if statuses}}
        {{#each statuses}}
        <option value="{{this}}">{{this}}</option>
        {{/each}}
        {{else}}
        <option value="Received">Received</option>
        <option value="Washing">Washing</option>
        <option value="Ready">Ready</option>
        <option value="Delivered">Delivered</option>
        {{/if}}
    </select>

    <button type="submit">Update Status</button>
</form>