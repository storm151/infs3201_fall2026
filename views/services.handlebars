<h1>Services</h1>

<table>
    <thead>
        <tr>
            <th>Item</th>
            <th>Price</th>
        </tr>
    </thead>
    <tbody>
        {{#each services}}
        <tr>
            <td>{{#if this.name}}{{this.name}}{{else if this.item}}{{this.item}}{{else}}{{this.serviceName}}{{/if}}</td>
            <td>{{this.price}}</td>
        </tr>
        {{/each}}
    </tbody>
</table>